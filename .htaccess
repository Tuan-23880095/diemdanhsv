# .htaccess — đặt ở gốc public_html trên Hostinger (LiteSpeed/Apache)
# Repo được deploy nguyên khối, nên phải chặn những thứ không dành cho trình duyệt.

Options -Indexes
DirectoryIndex index.html index.php

RewriteEngine On

# Cho phép thư mục xác minh SSL miễn phí (Let's Encrypt) — KHÔNG được chặn
RewriteRule ^\.well-known/ - [L]

# Chặn file/thư mục ẩn: .git, .github, .gitignore, .firebaserc…
RewriteRule (^|/)\. - [F,L]

# Chặn mã backend cũ, tài liệu nội bộ, schema CSDL, script quản trị CLI-only
# (tools/ — rule 3 của dự án, xem tools/README.md)
RewriteRule ^(gas|docs|db|tools|_firebase-upload)(/|$) - [F,L]

# Thư viện nội bộ của API — chỉ được nạp qua require từ api/index.php,
# không gọi trực tiếp qua web (GĐ5 review bảo mật, L1)
RewriteRule ^api/lib(/|$) - [F,L]

# File log lỗi PHP mặc định của shared hosting (tên 'error_log', không có
# đuôi .log) — có thể chứa thông tin nhạy cảm (GĐ5 review bảo mật, H2)
RewriteRule (^|/)error_log$ - [F,L]

# Chặn tài liệu và script không phục vụ web
RewriteRule \.(md|ps1|sql|gs|yml|yaml|log|bak)$ - [F,L]
RewriteRule ^firebase\.json$ - [F,L]

# Chống cache cho file cấu hình frontend và các trang HTML (02/10/2026, phát
# hiện khi thầy thử ?api=php: host/CDN/trình duyệt vẫn trả config.js bản cũ dù
# code mới đã deploy — ping PHP mới nhưng JS cũ). Trước cutover GĐ10 (đổi
# API_URL) điều này là BẮT BUỘC: nếu không, sinh viên vẫn chạy config cũ trỏ
# Apps Script sau khi đã chuyển sang PHP.
#
# 02/10 (tối, checklist mục 6): CÙNG LỖI với các file JS khác — trình duyệt/CDN
# giữ APIService.js cũ nên trang quản trị báo "adminSessionAttendance is not a
# function" dù code mới đã deploy. Nên: mọi .js/.css đều "no-cache, must-
# revalidate" (trình duyệt vẫn giữ bản sao nhưng phải hỏi lại máy chủ bằng
# ETag/If-Modified-Since → 304 nếu không đổi; site nhỏ, chi phí không đáng kể),
# và mọi <script>/<link> trong HTML đều có ?v=<ngày> — đổi phiên bản là mọi
# máy tải lại kể cả CDN bỏ qua header. Khi sửa JS/CSS: ĐỔI ?v= trong các trang.
<IfModule mod_headers.c>
  <FilesMatch "^config\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

