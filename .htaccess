# .htaccess — đặt ở gốc public_html trên Hostinger (LiteSpeed/Apache)
# Repo được deploy nguyên khối, nên phải chặn những thứ không dành cho trình duyệt.

Options -Indexes
DirectoryIndex index.html index.php

RewriteEngine On

# Cho phép thư mục xác minh SSL miễn phí (Let's Encrypt) — KHÔNG được chặn
RewriteRule ^\.well-known/ - [L]

# Chặn file/thư mục ẩn: .git, .github, .gitignore, .firebaserc…
RewriteRule (^|/)\. - [F,L]

# Chặn mã backend cũ, tài liệu nội bộ, schema CSDL, script quản trị CLI-only
# (tools/ — rule 3 của dự án, xem tools/README.md)
RewriteRule ^(gas|docs|db|tools|_firebase-upload)(/|$) - [F,L]

# Thư viện nội bộ của API — chỉ được nạp qua require từ api/index.php,
# không gọi trực tiếp qua web (GĐ5 review bảo mật, L1)
RewriteRule ^api/lib(/|$) - [F,L]

# File log lỗi PHP mặc định của shared hosting (tên 'error_log', không có
# đuôi .log) — có thể chứa thông tin nhạy cảm (GĐ5 review bảo mật, H2)
RewriteRule (^|/)error_log$ - [F,L]

# Chặn tài liệu và script không phục vụ web
RewriteRule \.(md|ps1|sql|gs|yml|yaml|log|bak)$ - [F,L]
RewriteRule ^firebase\.json$ - [F,L]
