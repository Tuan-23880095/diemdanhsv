# KIEMTRA — đặt trong public_html/kiemtra/ (Hostinger LiteSpeed/Apache).
# .htaccess ở thư mục con THAY THẾ luật rewrite của thư mục cha, nên phải tự
# chặn mọi thứ không dành cho trình duyệt.

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# .git (Hostinger Git deploy tạo ra), .gitignore, .htaccess…
RewriteRule (^|/)\. - [F,L]
# mã nội bộ, schema, công cụ chạy thử, tài liệu
RewriteRule ^(api/lib|db|tools|docs)(/|$) - [F,L]
RewriteRule (^|/)error_log$ - [F,L]
RewriteRule \.(md|sql|sqlite|ps1|sh|log|bak|csv)$ - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  # Không cho nhúng trang thi vào iframe của trang khác (chống trang giả bọc ngoài)
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
